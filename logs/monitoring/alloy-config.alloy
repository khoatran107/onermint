// Read validator JSON logs generated under local-runs.
loki.source.file "lab01" {
  targets = [
    {
      __path__ = "/var/log/lab01/**/events.jsonl",
      job      = "lab01",
    },
  ]
  forward_to = [loki.process.lab01.receiver]
  file_match {
    enabled     = true
    sync_period = "2s"
  }
}

// Store each line at the time the node logged it, not the time Alloy read it.
// Consensus steps last milliseconds, so ingest-time stamps would scramble their order.
// Compact logs carry "Ts"; Trace logs (Trace: true, used by the T1-T8 scenarios)
// carry "WallTime" instead. Lines with neither keep the read time.
loki.process "lab01" {
  stage.json {
    expressions = { ts = "Ts", wall = "WallTime" }
  }
  stage.timestamp {
    source            = "wall"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }
  stage.timestamp {
    source            = "ts"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

