{
  "uid": "lab01-network",
  "title": "Lab01 Blockchain Network",
  "description": "Validator health, consensus progress, batching, faults and logs",
  "tags": ["lab01", "blockchain"],
  "schemaVersion": 41,
  "refresh": "2s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Validator",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(up{job=\"lab01\"}, node)"},
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "options": {
        "mode": "markdown",
        "content": "No data? Start validators, then run `python tests/prepare_monitoring.py --config-dir config/<scenario>` and restart Prometheus. **Finalized gap must remain 0.** Consensus height is normally finalized height + 1. The consensus timeline and proposer table are read from node logs (Loki); zoom to a few minutes to see individual steps."
      },
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reachable validators",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(up{job=\"lab01\",node=~\"$node\"})", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name"},
      "gridPos": {"x": 0, "y": 3, "w": 6, "h": 4}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Finalized height (minimum)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "min(lab01_ledger_height{node=~\"$node\"})", "instant": true}],
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value_and_name"},
      "gridPos": {"x": 6, "y": 3, "w": 6, "h": 4}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Finalized height gap",
      "description": "Must be zero for agreement among reachable validators.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(lab01_ledger_height{node=~\"$node\"}) - min(lab01_ledger_height{node=~\"$node\"})", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name"},
      "gridPos": {"x": 12, "y": 3, "w": 6, "h": 4}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pending transactions",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(lab01_mempool_transactions{node=~\"$node\"})", "instant": true}],
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value_and_name"},
      "gridPos": {"x": 18, "y": 3, "w": 6, "h": 4}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Finalized height by validator",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lab01_ledger_height{node=~\"$node\"}", "legendFormat": "node {{node}}"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAM mempool by validator",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lab01_mempool_transactions{node=~\"$node\"}", "legendFormat": "node {{node}}"}],
      "fieldConfig": {"defaults": {"min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8}
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Consensus step (one entry per node log line)",
      "description": "Built from consensus_step log lines, not from sampled gauges, so millisecond steps are not missed. PROPOSING = this node is the proposer of the round. Works with both compact and Trace logs (Trace writes Step as 1/2/3). Zoom to a short range: the query returns at most 5000 lines.",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "direction": "forward",
          "maxLines": 5000,
          "expr": "{job=\"lab01\"} | json | Event=\"consensus_step\" | Node=~\"$node\" | label_format step=`{{ if eq .Step \"1\" }}PROPOSE{{ else if eq .Step \"2\" }}PREVOTE{{ else if eq .Step \"3\" }}PRECOMMIT{{ else }}{{ .Step }}{{ end }}` | label_format role=`{{ if and (eq .step \"PROPOSE\") (eq .Proposer .Node) }}PROPOSING{{ else }}{{ .step }}{{ end }}` | line_format `{\"node\":\"{{.Node}}\",\"state\":\"{{.role}}\"}`"
        }
      ],
      "transformations": [
        {"id": "extractFields", "options": {"source": "Line", "format": "json", "replace": false, "keepTime": false}},
        {"id": "filterFieldsByName", "options": {"include": {"names": ["Time", "node", "state"]}}},
        {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "node"}, {"field": "Time"}]}},
        {"id": "partitionByValues", "options": {"fields": ["node"], "naming": {"asLabels": true}}}
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "node ${__field.labels.node}",
          "custom": {"fillOpacity": 85, "lineWidth": 0},
          "mappings": [
            {"type": "value", "options": {
              "PROPOSE": {"text": "PROPOSE", "color": "blue", "index": 0},
              "PROPOSING": {"text": "PROPOSING", "color": "purple", "index": 1},
              "PREVOTE": {"text": "PREVOTE", "color": "orange", "index": 2},
              "PRECOMMIT": {"text": "PRECOMMIT", "color": "green", "index": 3}
            }}
          ]
        },
        "overrides": []
      },
      "options": {"mergeValues": false, "showValue": "auto", "rowHeight": 0.8, "alignValue": "left", "legend": {"showLegend": true, "placement": "bottom"}},
      "gridPos": {"x": 0, "y": 15, "w": 14, "h": 9}
    },
    {
      "id": 17,
      "type": "table",
      "title": "Proposer per height and round",
      "description": "Which node proposes each (height, round). Round > 0 means the earlier round timed out. Log lines written before the Proposer field existed are skipped.",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "direction": "forward",
          "maxLines": 5000,
          "expr": "{job=\"lab01\"} | json | Event=\"consensus_step\" | label_format step=`{{ if eq .Step \"1\" }}PROPOSE{{ else if eq .Step \"2\" }}PREVOTE{{ else if eq .Step \"3\" }}PRECOMMIT{{ else }}{{ .Step }}{{ end }}` | step=\"PROPOSE\" | Proposer!=\"\" | line_format `{\"height\":\"{{.Height}}\",\"round\":\"{{.Round}}\",\"proposer\":\"{{.Proposer}}\"}`"
        }
      ],
      "transformations": [
        {"id": "extractFields", "options": {"source": "Line", "format": "json", "replace": false, "keepTime": false}},
        {"id": "filterFieldsByName", "options": {"include": {"names": ["Time", "height", "round", "proposer"]}}},
        {"id": "convertFieldType", "options": {"conversions": [
          {"targetField": "height", "destinationType": "number"},
          {"targetField": "round", "destinationType": "number"},
          {"targetField": "proposer", "destinationType": "number"}
        ]}},
        {"id": "groupBy", "options": {"fields": {
          "height": {"operation": "groupby"},
          "round": {"operation": "groupby"},
          "proposer": {"operation": "aggregate", "aggregations": ["last"]},
          "Time": {"operation": "aggregate", "aggregations": ["min"]}
        }}},
        {"id": "organize", "options": {"renameByName": {"height": "Height", "round": "Round", "proposer (last)": "Proposer node", "Time (min)": "First seen"}}},
        {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "Height", "desc": true}, {"field": "Round", "desc": true}]}}
      ],
      "options": {"showHeader": true, "cellHeight": "sm"},
      "gridPos": {"x": 14, "y": 15, "w": 10, "h": 9}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Consensus height and round",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "lab01_consensus_height{node=~\"$node\"}", "legendFormat": "height node {{node}}"},
        {"expr": "lab01_consensus_round{node=~\"$node\"}", "legendFormat": "round node {{node}}"}
      ],
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 6}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Commits and batch waits",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (node,event) (rate(lab01_events_total{node=~\"$node\",event=~\"state_commit|block_wait_elapsed\"}[1m]))", "legendFormat": "node {{node}} {{event}}"}
      ],
      "gridPos": {"x": 0, "y": 30, "w": 8, "h": 7}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Timeouts and rejected transactions",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (node,event) (rate(lab01_events_total{node=~\"$node\",event=~\"consensus_timeout|transaction_reject|queue_full\"}[1m]))", "legendFormat": "node {{node}} {{event}}"}
      ],
      "gridPos": {"x": 8, "y": 30, "w": 8, "h": 7}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Injected network faults",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (node,event) (rate(lab01_events_total{node=~\"$node\",event=~\"fault_.*|block|unblock\"}[1m]))", "legendFormat": "node {{node}} {{event}}"}
      ],
      "gridPos": {"x": 16, "y": 30, "w": 8, "h": 7}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Outbound queue",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lab01_outbound_queue{node=~\"$node\"}", "legendFormat": "node {{node}}"}],
      "gridPos": {"x": 0, "y": 37, "w": 8, "h": 7}
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Min transactions per block",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(lab01_config_min_block_transactions{node=~\"$node\"})", "instant": true}],
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value_and_name"},
      "gridPos": {"x": 8, "y": 37, "w": 8, "h": 7}
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Maximum batch wait",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(lab01_config_block_max_wait_milliseconds{node=~\"$node\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value_and_name"},
      "gridPos": {"x": 16, "y": 37, "w": 8, "h": 7}
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Validator events",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{job=\"lab01\"} | json | Node=~\"$node\" | line_format \"{{ or .Time .WallTime }} node={{.Node}} {{.Event}} height={{.Height}} round={{.Round}} {{ or .Detail .Reason }}\"",
          "refId": "A"
        }
      ],
      "options": {"showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"},
      "gridPos": {"x": 0, "y": 44, "w": 24, "h": 12}
    }
  ]
}
